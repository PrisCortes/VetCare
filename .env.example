# Copiar como .env únicamente si se necesita cambiar el entorno local.
WEB_PORT=5173
API_PORT=8787
APP_ORIGIN=http://127.0.0.1:5173
# Solo escritorio distribuido: origen HTTPS ya publicado de la API y la web central.
# VETCARE_APP_URL=https://vetcare.example
# Generar con npm run offline:keys; solo backend.
OFFLINE_PRIVATE_KEY=
# PHP_BINARY=C:/php/php.exe
# Solo backend central: completar en los secretos del alojamiento, nunca en web/ ni Electron.
DB_HOST=mysql-[cuenta].alwaysdata.net
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL_CA=/ruta/privada/ca.pem
# Reutiliza conexiones TLS en procesos PHP activos; usa 0 solo si el alojamiento lo exige.
DB_PERSISTENT=1
