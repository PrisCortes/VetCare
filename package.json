{
  "name": "vetcare-system",
  "version": "0.1.0",
  "private": true,
  "description": "VetCare: web PHP y escritorio Windows, preparación T15",
  "type": "module",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
