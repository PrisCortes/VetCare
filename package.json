{
  "name": "vetcare-system",
  "version": "0.1.0",
  "private": true,
  "description": "VetCare: web PHP y escritorio Windows, preparación T15",
  "type": "module",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:desktop": "node scripts/desktop.mjs",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/api.test.mjs tests/storage.test.mjs tests/views.test.mjs tests/central-database.test.mjs tests/auth.test.mjs tests/owners.test.mjs",
    "test:owners:database": "node scripts/test-owners-database.mjs",
    "test:auth": "node --test tests/auth.test.mjs",
    "test:auth:database": "node scripts/test-auth-database.mjs",
    "test:storage": "node --test tests/storage.test.mjs",
    "test:desktop-storage": "node scripts/test-desktop-storage.mjs",
    "test:integration": "node --test tests/environment.test.mjs",
    "doctor": "node scripts/doctor.mjs",
    "test:views": "node --test tests/views.test.mjs",
    "db:check": "node scripts/database.mjs",
    "db:migrate": "node scripts/auth-console.mjs migrate",
    "auth:create-admin": "node scripts/auth-console.mjs create-admin",
    "db:prepare-ca": "node scripts/prepare-ca.mjs",
    "test:central": "node --test tests/central-database.test.mjs"
  },
  "devDependencies": {
    "electron": "^45.3.4"
  }
}
